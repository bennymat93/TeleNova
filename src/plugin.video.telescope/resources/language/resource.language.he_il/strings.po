msgid "Folder for the configuration file"
msgstr "תיקייה לשמירת קובץ התצורה"

msgctxt "#30160"
msgid "The export failed. Nothing was changed."
msgstr "הייצוא נכשל. דבר לא השתנה."

msgctxt "#30161"
msgid "Configuration exported to:"
msgstr "התצורה יוצאה אל:"

msgctxt "#30162"
msgid "Includes the Telegram login."
msgstr "כולל את החיבור לטלגרם."

msgctxt "#30163"
msgid "No Telegram login on this device - settings only."
msgstr "אין חיבור טלגרם במכשיר הזה - הגדרות בלבד."

msgctxt "#30164"
msgid "This is not a valid TeleNova configuration file, or it is damaged. Nothing was changed."
msgstr "זה אינו קובץ תצורה תקין של TeleNova, או שהקובץ פגום. דבר לא השתנה."

msgctxt "#30165"
msgid "Import the configuration saved on %s? The current settings and Telegram login of this device are replaced."
msgstr "לייבא את התצורה שנשמרה ב-%s? ההגדרות וחיבור הטלגרם הנוכחיים במכשיר הזה יוחלפו."

msgctxt "#30166"
msgid "Wrong password (or the file is damaged). Nothing was changed."
msgstr "סיסמה שגויה (או שהקובץ פגום). דבר לא השתנה."

msgctxt "#30167"
msgid "Configuration imported."
msgstr "התצורה יובאה."

msgctxt "#30168"
msgid "Telegram is not logged in yet - open \"Account & Status\" to log in."
msgstr "הטלגרם עדיין לא מחובר - פתח \"חשבון ומצב\" כדי להתחבר."

msgctxt "#30171"
msgid "cached"
msgstr "מוכן להפעלה"

msgctxt "#30172"
msgid "Real-Debrid link failed, trying the next source"
msgstr "קישור Real-Debrid נכשל, עובר למקור הבא"

msgctxt "#30173"
msgid "%s - premium, %d days left"
msgstr "%s - פרימיום, נותרו %d ימים"

msgctxt "#30174"
msgid "Log out of Real-Debrid"
msgstr "התנתקות מ-Real-Debrid"

msgctxt "#30175"
msgid "not connected - press to connect"
msgstr "לא מחובר - לחץ לחיבור"

msgctxt "#30176"
msgid "On a phone or computer open %s and enter the code: [B]%s[/B]"
msgstr "בטלפון או במחשב פתח את %s והזן את הקוד: [B]%s[/B]"

msgctxt "#32110"
msgid "Real-Debrid"
msgstr "Real-Debrid"

msgctxt "#32111"
msgid "Use Real-Debrid"
msgstr "שימוש ב-Real-Debrid"

msgctxt "#32112"
msgid "API token (or connect from "Account & Status")"
msgstr "מפתח API (או חיבור מ"חשבון ומצב")"

msgctxt "#32113"
msgid "Find cached torrents (Torrentio index)"
msgstr "חיפוש טורנטים מוכנים (אינדקס Torrentio)"

msgctxt "#32114"
msgid "Let the index check the Real-Debrid cache (sends the key to Torrentio)"
msgstr "בדיקת זמינות ב-Real-Debrid דרך האינדקס (המפתח נשלח ל-Torrentio)"

msgctxt "#32115"
msgid "Include my Real-Debrid cloud"
msgstr "לכלול את הענן שלי ב-Real-Debrid"

msgctxt "#32116"
msgid "Real-Debrid results listed"
msgstr "מספר תוצאות Real-Debrid"

msgctxt "#32108"
msgid "Heaviest file listed, Mbit/s (0 = no limit; Telegram never above what the account is served)"
msgstr "הקובץ הכבד ביותר שמוצג, Mbit לשנייה (0 = בלי הגבלה; בטלגרם לעולם לא מעל מה שהחשבון מקבל)"
