msgstr "Результатов Real-Debrid"

msgctxt "#32108"
msgid "Heaviest file listed, Mbit/s (0 = no limit; Telegram never above what the account is served)"
msgstr "Самый тяжёлый файл в списке, Мбит/с (0 = без ограничения; в Telegram не выше скорости аккаунта)"

msgctxt "#30177"
msgid "Services and connections - everything in one place"
msgstr "Сервисы и подключения - всё в одном месте"

msgctxt "#30178"
msgid "Setup backup: sync between devices, export, import"
msgstr "Копия настроек: синхронизация, экспорт, импорт"

msgctxt "#32117"
msgid "StremThru: second check of what Real-Debrid has (the Real-Debrid key is sent to that server)"
msgstr "StremThru: вторая проверка наличия в Real-Debrid (ключ Real-Debrid отправляется на этот сервер)"

msgctxt "#32118"
msgid "StremThru server address (empty = the public one)"
msgstr "Адрес сервера StremThru (пусто = общий)"

msgctxt "#32119"
msgid "OpenSubtitles: certain identification of files by their fingerprint"
msgstr "OpenSubtitles: точное опознание файлов по отпечатку"

msgctxt "#32120"
msgid "OpenSubtitles API key"
msgstr "Ключ API OpenSubtitles"
